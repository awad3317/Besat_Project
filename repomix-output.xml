                'class' => 'bg-error-50 text-error-600 dark:bg-error-500/15 dark:text-error-500',
            ]
        ];
    }
    public function getStatusInfo()
    {
        $config = self::statusConfig();
        return $config[$this->status] ?? ($config['pending'] ?? [
