     */
    public function store(int $requestId, array $stopsData)
    {
        $formattedStops = [];
        
        foreach ($stopsData as $index => $stop) {
            $formattedStops[] = [
                'request_id' => $requestId,
                'latitude'   => $stop['latitude'],
