            return WebResponseClass::sendValidationError($validator);
        }
        try {
            $vehicle = $this->vehicleRepository->getById($id);
            $hasAc = $request->boolean('has_ac_option');
            $data = [
                'type' => $request->type,
                'description' => $request->description,
                'max_passengers' => $request->max_passengers,
